{
  "enabledPlugins": {
    "pstack@pstack-claude": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__ccd_pr__set_auto_merge",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-merge.sh"
          }
        ]
      }
    ]
  }
}
