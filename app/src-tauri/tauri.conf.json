{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "grove",
  "version": "0.1.0",
  "identifier": "com.grovecode.desktop",
  "build": {
    "beforeDevCommand": "cargo build -p grove-mcp && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "grove",
        "width": 1000,
        "height": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 28 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "license": "MIT",
    "copyright": "Copyright (c) 2026 Anton Florendo",
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
