def skill_list():
    """What skills/list returns now: the file FAKE_CODEX_SKILLS names, read at each request, or
    SKILLS when it is unset or the file is missing."""
    path = os.environ.get("FAKE_CODEX_SKILLS", "")
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except FileNotFoundError:
        return SKILLS


ESCAPES = {"b": "\b", "t": "\t", "n": "\n", "f": "\f", "r": "\r", '"': '"', "\\": "\\"}
BARE_KEY = re.compile(r"[A-Za-z0-9_-]+")
NUMBER = re.compile(r"[+-]?[0-9][0-9_]*(\.[0-9_]+)?([eE][+-]?[0-9_]+)?")


def skip(s, i):
    while s[i:i + 1] in (" ", "\t", "\r", "\n"):
        i += 1
    return i


def toml_value(s, i):
    """Parses the TOML value at s[i:]: strings, numbers, booleans, arrays and
    inline tables. Returns (value, end). Raises ValueError or IndexError."""
    c = s[i:i + 1]
    if c == '"':
        out = []
        i += 1
        while s[i] != '"':
            if s[i] != "\\":
                out.append(s[i])
                i += 1
            elif s[i + 1] in ESCAPES:
                out.append(ESCAPES[s[i + 1]])
                i += 2
            elif s[i + 1] in "uU":
                n = 4 if s[i + 1] == "u" else 8
                digits = s[i + 2:i + 2 + n]
                if len(digits) != n:
                    raise ValueError("short escape")
                out.append(chr(int(digits, 16)))
                i += 2 + n
            else:
                raise ValueError("bad escape")
        return "".join(out), i + 1
    if c == "'":
        end = s.index("'", i + 1)
        return s[i + 1:end], end + 1
    if c == "[":
        items = []
        i = skip(s, i + 1)
        while s[i:i + 1] != "]":
            value, i = toml_value(s, i)
            items.append(value)
            i = skip(s, i)
            if s[i:i + 1] == ",":
                i = skip(s, i + 1)
            elif s[i:i + 1] != "]":
                raise ValueError("bad array")
        return items, i + 1
    if c == "{":
        table = {}
        i = skip(s, i + 1)
        while s[i:i + 1] != "}":
            path, i = toml_key(s, i)
            i = skip(s, i)
            if s[i:i + 1] != "=":
                raise ValueError("no =")
            value, i = toml_value(s, skip(s, i + 1))
            put(table, path, value)
            i = skip(s, i)
            if s[i:i + 1] == ",":
                i = skip(s, i + 1)
            elif s[i:i + 1] != "}":
                raise ValueError("bad inline table")
        return table, i + 1
    for word, value in (("true", True), ("false", False)):
        if s.startswith(word, i):
            return value, i + len(word)
    m = NUMBER.match(s, i)
    if not m:
        raise ValueError("not a value")
    text = m.group().replace("_", "")
    return (float(text) if m.group(1) or m.group(2) else int(text)), m.end()


def toml_key(s, i):
    """Parses a dotted key at s[i:]. Returns (list of parts, end)."""
    path = []
    while True:
        i = skip(s, i)
        if s[i:i + 1] in ('"', "'"):
            part, i = toml_value(s, i)
        else:
            m = BARE_KEY.match(s, i)
            if not m:
                raise ValueError("bad key")
            part, i = m.group(), m.end()
        path.append(part)
        j = skip(s, i)
        if s[j:j + 1] != ".":
            return path, i
        i = j + 1


def put(table, path, value):
    for part in path[:-1]:
        table = table.setdefault(part, {})
        if not isinstance(table, dict):
            raise ValueError(f"{part} is not a table")
    table[path[-1]] = value


def override(flag, config):
    """Applies one -c key=value to config. Like Codex, it takes a value that
    is not TOML as a plain string."""
    key, eq, text = flag.partition("=")
    try:
        path, end = toml_key(key, 0)
        if not eq or skip(key, end) != len(key):
            raise ValueError("no key")
    except (ValueError, IndexError):
        raise Usage(f"-c {flag}: want key=value")
    text = text.strip()
    try:
        value, end = toml_value(text, 0)
        if end != len(text):
            raise ValueError("trailing text")
    except (ValueError, IndexError):
        value = text
    try:
        put(config, path, value)
    except ValueError as e:
        raise Usage(f"-c {flag}: {e}")


def parse_args(args):
    """Returns (command, config from the -c overrides, resume id, prompt).
    command is "tui", "resume" or "app-server". A subcommand comes first."""
    command = args[0] if args[:1] in (["resume"], ["app-server"]) else "tui"
    config = {}
    positional = []
    no_daemon = False
    model = None
    i = 0 if command == "tui" else 1
    while i < len(args):
        arg = args[i]
        i += 1
        if arg == "-c":
            if i == len(args):
                raise Usage("-c needs a value")
            override(args[i], config)
            i += 1
        elif arg == "-m" and command != "app-server":
            if i == len(args):
                raise Usage("-m needs a value")
            if model is not None:
                raise Usage("the argument '--model <MODEL>' cannot be used multiple times")
            model = args[i]
            i += 1
        elif arg == "--no-daemon" and command != "app-server":
            if no_daemon:
                raise Usage("--no-daemon given twice")
            no_daemon = True
        elif arg.startswith("-"):
            raise Usage(f"unknown argument {arg}")
        else:
            positional.append(arg)
    most = {"tui": 1, "resume": 2, "app-server": 0}[command]
    if len(positional) > most:
        raise Usage(f"{command}: too many arguments {positional}")
    session_id = None
    if command == "resume":
        session_id = positional.pop(0) if positional else ""
        try:
            uuid.UUID(session_id)
        except ValueError:
            raise Usage(f"resume wants a session id (a UUID), got {session_id!r}")
    check_config(config)
    return command, config, session_id, positional[0] if positional else ""


def check_config(config):
    """Allows only the overrides grove passes, in the shapes Codex accepts."""
    def want(ok, what):
        if not ok:
            raise Usage(f"-c {what}")

    def strings(value):
        return isinstance(value, list) and all(isinstance(v, str) for v in value)

    want(set(config) <= {"hooks", "mcp_servers", "shell_environment_policy", "model_reasoning_effort"},
         f"{sorted(config)}: grove passes only hooks, mcp_servers.grove, shell_environment_policy.set"
         " and model_reasoning_effort")
    want(isinstance(config.get("model_reasoning_effort", ""), str), "model_reasoning_effort: want a string")
    hooks = config.get("hooks", {})
    want(isinstance(hooks, dict) and set(hooks) <= set(EVENTS), f"hooks: want only events {EVENTS}")
    for event, groups in hooks.items():
        want(isinstance(groups, list), f"hooks.{event}: want a list of groups")
        for group in groups:
            # The recording checked only "*" against the real CLI, so other matchers fail.
            want(isinstance(group, dict) and set(group) <= {"matcher", "hooks"}
                 and group.get("matcher", "*") == "*" and isinstance(group.get("hooks"), list),
                 f"hooks.{event}: want groups with only hooks and matcher \"*\": {group}")
            for hook in group["hooks"]:
                timeout = hook.get("timeout", 0) if isinstance(hook, dict) else None
                want(isinstance(hook, dict) and set(hook) <= {"type", "command", "timeout"}
                     and hook.get("type") == "command" and isinstance(hook.get("command"), str)
                     and isinstance(timeout, int) and not isinstance(timeout, bool) and timeout >= 0,
                     f"hooks.{event}: want command hooks with only type, command and timeout: {hook}")
    servers = config.get("mcp_servers", {})
    want(isinstance(servers, dict) and set(servers) <= {"grove"}, "mcp_servers: grove passes only grove")
    grove = servers.get("grove", {"command": ""})
    want(isinstance(grove, dict) and set(grove) <= {"command", "args", "env_vars"}
         and isinstance(grove.get("command"), str) and strings(grove.get("args", []))
         and strings(grove.get("env_vars", [])),
         f"mcp_servers.grove: want a command string, and args and env_vars as lists of strings: {grove}")
    policy = config.get("shell_environment_policy", {})
    want(isinstance(policy, dict) and set(policy) <= {"set"} and isinstance(policy.get("set", {}), dict)
         and all(isinstance(v, str) for v in policy.get("set", {}).values()),
         f"shell_environment_policy: grove passes only set, with string values: {policy}")


def hook_trust():
    trust = os.environ.get("FAKE_CODEX_HOOK_TRUST", "trusted")
    if trust not in ("trusted", "untrusted", "modified"):
        raise Usage(f"FAKE_CODEX_HOOK_TRUST is {trust!r}, want trusted, untrusted or modified")
    return trust


def hook_list(hooks, trust):
    """The hooks/list entries for hooks from -c overrides, as 0.158.0 lists
    them. currentHash is the fake's own, and the same entry always gets the
    same hash."""
    entries = []
    for event in EVENTS:
        snake = re.sub(r"(?<!^)([A-Z])", r"_\1", event).lower()
        for g, group in enumerate(hooks.get(event, [])):
            for h, hook in enumerate(group["hooks"]):
                digest = hashlib.sha256(json.dumps([event, group.get("matcher"), hook], sort_keys=True).encode())
                entries.append({
                    "key": f"/<session-flags>/config.toml:{snake}:{g}:{h}", "eventName": event[0].lower() + event[1:],
                    "handlerType": "command", "command": hook["command"], "async": False,
                    "matcher": group.get("matcher"), "timeoutSec": hook.get("timeout", DEFAULT_TIMEOUT.get(event, 600)),
                    "statusMessage": None, "additionalContextLimit": None,
                    "sourcePath": "/<session-flags>/config.toml", "source": "sessionFlags", "pluginId": None,
                    "displayOrder": len(entries), "enabled": True, "isManaged": False,
                    "currentHash": "sha256:" + digest.hexdigest(), "trustStatus": trust})
    return entries


def stdin_lines():
    """Each line of stdin with its newline. Read with os.read, not sys.stdin: a thread blocked
    in the buffered reader holds its lock, and the interpreter aborts when it exits then."""
    buf = b""
    while True:
        try:
            data = os.read(0, 4096)
        except OSError:
            data = b""
        if not data:
            break
        *lines, buf = (buf + data).split(b"\n")
        for line in lines:
            yield line + b"\n"
    if buf:
        yield buf


class AppServer:
    """Acts as codex app-server on stdio: JSON-RPC, one message per line. A
    thread reads the client's messages and answers the requests the fake
    knows. The scenario, on the main thread, sends the rest and waits for the
    client's messages. README.md lists what it answers."""

    def __init__(self, hooks, trust, slots, log):
        self.hooks, self.trust, self.slots, self.log = hooks, trust, slots, log
        self.out = threading.Lock()
        self.cond = threading.Condition()
        self.messages = []
        self.pos = 0
        self.closed = False
        self.failure = None
        self.rejected = False
        self.initialized = False
        self.thread = None
        self.turn = None
        threading.Thread(target=self.read, daemon=True).start()

    def send(self, msg):
        with self.out:
            write_out((json.dumps(msg, separators=(",", ":")) + "\n").encode())

    def error(self, rid, message):
        self.rejected = True
        self.send({"error": {"code": -32600, "message": message}, "id": rid})

    def read(self):
        try:
            for line in stdin_lines():
                self.log.write(stdin=line.decode("latin-1"))
                try:
                    msg = json.loads(line)
                    params = msg.get("params") or {}
                except (ValueError, AttributeError):
                    raise Fail(f"app-server: not a JSON object: {line!r}")
                self.rejected = False
                if "id" in msg and "method" in msg:
                    with self.cond:
                        self.answer(msg["method"], msg["id"], params)
                elif msg.get("method") == "initialized":
                    # The real server sends this once the client says initialized.
                    self.send({"method": "remoteControl/status/changed",
                               "params": {"status": "disabled", "serverName": platform.node(),
                                          "installationId": "00000000-0000-4000-8000-000000000000",
                                          "environmentId": None},
                               "emittedAtMs": int(time.time() * 1000)})
                # After the answer, so a step waiting for a request runs after it. A step never
                # waits for a request the fake rejected.
                if not self.rejected:
                    with self.cond:
                        self.messages.append(msg)
                        self.cond.notify_all()
        except Fail as e:
            self.failure = e
        except Exception as e:
            # Any other error ends the fake too, with its message, never a hang.
            self.failure = Fail(f"app-server: {type(e).__name__}: {e}")
        finally:
            with self.cond:
                self.closed = True
                self.cond.notify_all()

    def answer(self, method, rid, params):
        if method == "initialize":
            if self.initialized:
                return self.error(rid, "Already initialized")
            self.initialized = True
            client = params.get("clientInfo") or {}
            name, version = client.get("name", ""), client.get("version", "")
            agent = (f"{name}/{VERSION} ({platform.system()} {platform.release()}; {platform.machine()}) "
                     f"{os.environ.get('TERM', 'unknown')} ({name}; {version})")
            return self.send({"id": rid, "result": {
                "userAgent": agent, "codexHome": self.slots["codex_home"], "platformFamily": "unix",
                "platformOs": "macos" if sys.platform == "darwin" else sys.platform}})
        if not self.initialized:
            return self.error(rid, "Not initialized")
        if method == "hooks/list":
            cwds = params.get("cwds") or [os.getcwd()]
            entries = hook_list(self.hooks, self.trust)
            return self.send({"id": rid, "result": {"data": [{"cwd": cwd, "hooks": entries, "warnings": [],
                                                               "errors": []} for cwd in cwds]}})
        if method == "model/list":
            return self.send({"id": rid, "result": {"data": MODELS, "nextCursor": None}})
        if method == "skills/list":
            cwds = params.get("cwds") or [os.getcwd()]
            skills = skill_list()
            return self.send({"id": rid, "result": {"data": [{"cwd": cwd, "skills": skills, "errors": []}
                                                              for cwd in cwds]}})
        if method == "account/read":
            account = json.loads(os.environ.get("FAKE_CODEX_ACCOUNT", "null"))
            return self.send({"id": rid, "result": {"account": account, "requiresOpenaiAuth": True}})
        if method in ("thread/start", "thread/resume"):
            if self.thread:
                return self.error(rid, "the fake runs one thread per connection")
            thread_id = params.get("threadId") if method == "thread/resume" else str(uuid.uuid4())
            try:
                uuid.UUID(thread_id)
            except (TypeError, ValueError):
                return self.error(rid, f"thread/resume: threadId {thread_id!r} is not a UUID")
            self.thread = self.slots["thread_id"] = thread_id
            self.slots.update(model=MODELS[0]["model"], effort=MODELS[0]["defaultReasoningEffort"])
            thread = {"id": thread_id, "sessionId": thread_id, "cwd": os.getcwd(), "cliVersion": VERSION,
                      "status": {"type": "idle"}, "turns": []}
            # Like the real server, only a resume's reply holds the turns so far.
            turns = read_record("FAKE_CODEX_RECORD", thread_id) if method == "thread/resume" else []
            self.send({"id": rid, "result": {"thread": dict(thread, turns=turns), "model": "gpt-5.5", "modelProvider": "openai",
                                             "cwd": os.getcwd(), "approvalPolicy": "on-request"}})
            return self.send({"method": "thread/started", "params": {"thread": thread}})
        if method == "turn/start":
            if not self.thread or params.get("threadId") != self.thread:
                return self.error(rid, f"turn/start: no thread {params.get('threadId')!r}")
            if self.turn:
                return self.error(rid, "turn/start: the fake runs one turn at a time")
            text = params.get("input")
            if not (isinstance(text, list) and text and all(
                    isinstance(i, dict) and i.get("type") == "text" and isinstance(i.get("text"), str)
                    and isinstance(i.get("text_elements"), list) for i in text)):
                return self.error(rid, f"turn/start: want text input with text_elements: {text!r}")
            # Like Codex, a model or effort given here holds for this turn and the later ones.
            model = params.get("model") or self.slots["model"]
            effort = params.get("effort") or self.slots["effort"]
            known = next((m for m in MODELS if m["model"] == model), None)
            if not known:
                return self.error(rid, f"turn/start: no model {model!r}")
            if effort not in [e["reasoningEffort"] for e in known["supportedReasoningEfforts"]]:
                return self.error(rid, f"turn/start: {model} takes no effort {effort!r}")
            self.slots.update(model=model, effort=effort, text=text[0]["text"])
            self.turn = self.slots["turn_id"] = str(uuid.uuid4())
            return self.send({"id": rid, "result": {"turn": {"id": self.turn, "items": [], "status": "inProgress",
                                                             "error": None}}})
        if method == "turn/interrupt":
            if not self.turn or params.get("threadId") != self.thread or params.get("turnId") != self.turn:
                return self.error(rid, f"turn/interrupt: no turn {params.get('turnId')!r} running")
            return self.send({"id": rid, "result": {}})
        self.error(rid, f"Invalid request: unknown variant `{method}`, the fake does not know it")

    def wait_message(self, kind):
        """Returns the client's next message after the last match with method
        kind, or its next response for "response"."""
        with self.cond:
            while True:
                if self.pos < len(self.messages):
                    msg = self.messages[self.pos]
                    self.pos += 1
                    if msg.get("method", "response" if "id" in msg else None) == kind:
                        return msg
                    continue
                if self.closed:
                    raise self.failure or Fail(f"stdin closed while waiting for a {kind} message")
                self.cond.wait()

    def play(self, steps):
        for step in steps:
            if "send" in step:
                with self.cond:
                    msg = fill(step["send"], self.slots)
                    if msg.get("method") == "turn/completed":
                        self.turn = None
                self.send(msg)
            elif "wait_message" in step:
                self.wait_message(step["wait_message"])
            elif "record" in step:
                with self.cond:
                    message = fill(step["record"], self.slots)
                append_record("FAKE_CODEX_RECORD", self.slots["thread_id"], message)
            elif "sleep" in step:
                time.sleep(step["sleep"])
            elif "exit" in step:
                return step["exit"]
        # Like the real server, it serves until stdin closes.
        with self.cond:
            while not self.closed:
                self.cond.wait()
        if self.failure:
            raise self.failure
        return 0


def run(args, log):
    command, config, session_id, prompt = parse_args(args)
    log.write(config=config)
    hooks = config.get("hooks", {})
    trust = hook_trust()
    home = os.environ.get("HOME", "")
    codex_home = os.environ.get("CODEX_HOME") or os.path.join(home, ".codex")
    slots = {"session_id": session_id or str(uuid.uuid4()), "cwd": os.getcwd(), "home": home, "prompt": prompt,
             "codex_home": codex_home, "text": ""}
    if command == "app-server":
        # A variable of its own, as the hook check runs the app server beside the TUI.
        steps = load_scenario("FAKE_CODEX_APP_SERVER_SCENARIO", DATA, APP_SERVER_ACTIONS) \
            if os.environ.get("FAKE_CODEX_APP_SERVER_SCENARIO") else []
        return AppServer(hooks, trust, {**slots, "thread_id": "", "turn_id": ""}, log).play(steps)
    steps = load_scenario("FAKE_CODEX_SCENARIO", DATA)
    # Hooks get the fake's own environment. shell_environment_policy does not apply to them.
    shell = [os.environ.get("SHELL", "/bin/sh"), "-lc"]

    def fire(payload):
        event = payload["hook_event_name"]
        if trust != "trusted":
            log.write(hook_skipped=event, trust=trust)
            return
        run_hooks(hooks.get(event, []), payload, None, log, shell, dict(os.environ), DEFAULT_TIMEOUT.get(event, 600))

    # The server gets the variables env_vars names from the fake's own environment.
    def call(name, tool, arguments):
        server = config.get("mcp_servers", {}).get(name)
        if server is None:
            raise Usage(f"mcp_call: no MCP server {name} in the -c overrides")
        passed = {k: os.environ[k] for k in server.get("env_vars", []) if k in os.environ}
        mcp_call(server["command"], server.get("args", []), mcp_env(passed), tool, arguments, log)

    # Shell commands get the fake's own environment, then shell_environment_policy.set on top, as
    # under 0.158.0's default policy.
    def run_command(command):
        policy = config.get("shell_environment_policy", {}).get("set", {})
        run_shell(command, shell, {**os.environ, **policy}, log)

    stdin = Input(log)
    try:
        # Like the real TUI, which asks at startup and runs no hook until the user trusts them.
        if trust != "trusted" and hooks:
            write_out(screen(DATA, "hooks-review", slots))
        return play(steps, DATA, slots, stdin, log, fire,
                    record=lambda message: append_record("FAKE_CODEX_RECORD", slots["session_id"], message),
                    call=call, shell=run_command)
    finally:
        stdin.restore()


if __name__ == "__main__":
    sys.exit(main("codex", "FAKE_CODEX", run))
