#!/bin/sh
# Runs the CI gates before a push and refuses the push when one fails.
# Setup, once in the main worktree: git config core.hooksPath .githooks
# The path is relative, so each worktree runs the hook from its own checkout.
# Tests: python3 -m unittest discover .github/scripts
#
# A gate group runs only when the pushed commits change a path it reads. The paths are listed in
# .github/scripts/step_groups_to_run.py. When the changed files cannot be listed, every group runs.

# git exports GIT_DIR to hooks in a linked worktree.
# Tests that run git in temp repos would act on this repo instead.
# shellcheck disable=SC2046 # one variable name per word
unset $(git rev-parse --local-env-vars)
cd "$(git rev-parse --show-toplevel)" || exit 1

typescript_directories="app sidecar/claude"

refuse_push() {
  echo "pre-push: $1" >&2
  echo "pre-push: push refused." >&2
  exit 1
}

hook_temp=$(mktemp -d "${TMPDIR:-/tmp}/grove-pre-push.XXXXXX") || refuse_push "could not make a temp folder."
trap 'rm -rf "$hook_temp"' EXIT
changed_files="$hook_temp/changed_files"
group_outputs="$hook_temp/group_outputs"
: > "$changed_files"

# git sends one line per pushed ref: <local ref> <local sha> <remote ref> <remote sha>.
# A deleted ref has a sha of zeros and pushes no commit.
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case $local_sha in *[!0]*) ;; *) continue ;; esac
  git diff --name-only --no-renames -z "origin/main...$local_sha" >> "$changed_files" ||
    changed_files_unlisted=yes
done
if [ -n "${changed_files_unlisted:-}" ]; then
  echo "pre-push: could not list the files the push changes against origin/main." >&2
  : > "$changed_files"
fi

# An empty list makes the script run every group.
if group_reasons=$(python3 .github/scripts/step_groups_to_run.py rust < "$changed_files" 2>&1 > "$group_outputs"); then
  echo "$group_reasons" | grep -E '^(rust|ts):' | sed 's/^/pre-push: /' >&2
else
  echo "$group_reasons" >&2
  echo "pre-push: step_groups_to_run.py failed, so every group runs." >&2
  printf 'rust=true\nts=true\n' > "$group_outputs"
fi
group_runs() {
  grep -qx "$1=true" "$group_outputs"
}

run_gate() {
  gate_directory=$1
  shift
  gate_name="$* (in $gate_directory)"
  gate_log="$hook_temp/gate.log"
  echo "pre-push: running $gate_name" >&2
  if ! (cd "$gate_directory" && exec "$@") > "$gate_log" 2>&1 9>&-; then
    cat "$gate_log" >&2
    refuse_push "FAILED gate: $gate_name"
  fi
}

if ! group_runs rust && ! group_runs ts; then
  echo "pre-push: no gate group reads the changed files, so no gate ran." >&2
  exit 0
fi

if group_runs ts; then
  # Without the local binary, npx would download a package or run a global tool.
  for typescript_directory in $typescript_directories; do
    for gate_binary in tsc eslint vitest; do
      [ -x "$typescript_directory/node_modules/.bin/$gate_binary" ] ||
        refuse_push "$typescript_directory/node_modules/.bin/$gate_binary is missing. Run: npm ci --prefix $typescript_directory"
    done
  done
fi

# The reviewer's run_gates.sh takes the same lock, so only one gate run goes at a time on this
# Mac. Runs that overlap overload it until timing tests fail. The lock is a flock on fd 9,
# which the kernel drops when this shell exits, however it dies. The gates run with fd 9 closed.
# So when only this shell is killed (Ctrl-C stops the gate too), its gate runs on without the
# lock, and the next run can overlap it. The other way, a test's stray child process that
# outlives its gate would hold the lock forever and block every push.
gate_lock_file="$HOME/.cache/grove-gates.lock"
mkdir -p "$HOME/.cache" || refuse_push "could not make $HOME/.cache for the gate lock."
exec 9>> "$gate_lock_file"
python3 - "$gate_lock_file" "pre-push in $PWD (pid $$)" <<'TAKE_GATE_LOCK' ||
import fcntl, os, sys, time
gate_lock_file, owner = sys.argv[1:]
try:
    fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    holder = open(gate_lock_file).read().strip() or "another gate run"
    print(f"pre-push: waiting for the gate lock, held by {holder}", file=sys.stderr, flush=True)
    fcntl.flock(9, fcntl.LOCK_EX)
os.ftruncate(9, 0)
os.write(9, f"{owner} since {time.strftime('%H:%M:%S')}\n".encode())
TAKE_GATE_LOCK
  refuse_push "could not take the gate lock $gate_lock_file."

if group_runs rust; then
  # One build folder outside the worktrees, for hook runs only. Every hook that builds here takes
  # the lock above, so no other build changes the folder during a run.
  export CARGO_TARGET_DIR="${GROVE_HOOK_TARGET_DIR:-$HOME/.cache/grove-hook/target}"
  echo "pre-push: the Rust gates build in $CARGO_TARGET_DIR" >&2
  run_gate . cargo fmt --check
  # Every checkout of grove gives the grove crates the same artifact names in that folder, and
  # cargo judges them fresh by mtime. A worktree whose files are older than another checkout's
  # build would test that checkout's code. So when another checkout built here last, the grove
  # crates, and the test scratch folder where tests build their own grove-hook, are rebuilt from
  # this one. Dependencies stay.
  last_checkout_file="$CARGO_TARGET_DIR/grove-last-checkout"
  if [ "$(cat "$last_checkout_file" 2>/dev/null)" != "$PWD" ]; then
    echo "pre-push: another checkout built here last, so the grove crates build again." >&2
    rm -rf "$CARGO_TARGET_DIR/tmp" || refuse_push "could not empty $CARGO_TARGET_DIR/tmp."
    run_gate . cargo clean --workspace
    if ! { mkdir -p "$CARGO_TARGET_DIR" && echo "$PWD" > "$last_checkout_file"; }; then
      refuse_push "could not write $last_checkout_file."
    fi
  fi
  run_gate . cargo clippy --all-targets -- -D warnings
  run_gate . cargo test
fi

if group_runs ts; then
  for typescript_directory in $typescript_directories; do
    run_gate "$typescript_directory" npx tsc --noEmit
    run_gate "$typescript_directory" npx eslint .
    run_gate "$typescript_directory" npx vitest run
  done
fi

echo "pre-push: all gates that ran passed." >&2
